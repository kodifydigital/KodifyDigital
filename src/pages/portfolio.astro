---
import Layout from "../layouts/Layout.astro";
import { PORTFOLIO_ITEMS } from "../data/portfolio";

const ACCENTS = {
  signal: "bg-signal",
  volt: "bg-volt",
  ember: "bg-ember",
};
---

<Layout
  title="Portfolio"
  description="A look at the projects Kodify Digital builds — custom software, web & mobile apps, and integrations for businesses in Malaysia."
>
  <section class="noise relative overflow-hidden px-6 pb-16 pt-40 lg:px-10">
    <div class="grid-bg absolute inset-0 opacity-40 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,black,transparent)]"></div>
    <div class="aurora-field" aria-hidden="true">
      <div class="aurora-blob aurora-blob-one"></div>
      <div class="aurora-blob aurora-blob-two"></div>
    </div>
    <div class="relative mx-auto max-w-7xl">
      <p class="reveal font-mono text-xs uppercase tracking-[0.2em] text-signal">Portfolio</p>
      <h1 class="reveal mt-6 max-w-2xl font-display text-5xl font-semibold leading-[1.02] tracking-tight text-paper sm:text-6xl">
        Selected work, growing every quarter.
      </h1>
      <p class="reveal mt-6 max-w-xl text-lg text-paper/60" data-delay="80">
        We're populating detailed case studies as current projects wrap. In the meantime, here's
        the shape of what we build.
      </p>
    </div>
  </section>

  <section class="relative px-6 pb-28 lg:px-10">
    <div class="mx-auto max-w-7xl">
      <div class="portfolio-toolbar mb-8 flex flex-col gap-4 p-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter portfolio projects">
          <button type="button" class="portfolio-filter is-active px-4 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-paper/65 transition-colors hover:bg-paper/10" data-filter="all">All work</button>
          <button type="button" class="portfolio-filter px-4 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-paper/65 transition-colors hover:bg-paper/10" data-filter="Custom Software">Software</button>
          <button type="button" class="portfolio-filter px-4 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-paper/65 transition-colors hover:bg-paper/10" data-filter="Web Application">Web</button>
          <button type="button" class="portfolio-filter px-4 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-paper/65 transition-colors hover:bg-paper/10" data-filter="Mobile App">Mobile</button>
          <button type="button" class="portfolio-filter px-4 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-paper/65 transition-colors hover:bg-paper/10" data-filter="System Integration">Systems</button>
        </div>
        <label class="flex items-center gap-3 px-2 font-mono text-[10px] uppercase tracking-[0.14em] text-paper/55">
          Sort
          <select data-portfolio-sort class="border border-paper/20 bg-transparent px-3 py-2 text-paper outline-none">
            <option value="newest">Newest first</option>
            <option value="oldest">Oldest first</option>
            <option value="category">By category</option>
          </select>
        </label>
      </div>

      <p class="mb-6 font-mono text-[10px] uppercase tracking-[0.14em] text-paper/50"><span data-portfolio-count>6</span> projects indexed</p>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-portfolio-grid>
        {
          PORTFOLIO_ITEMS.map((item, i) => (
            <article
              class="portfolio-card reveal group relative flex aspect-[4/5] flex-col justify-between overflow-hidden rounded-2xl border border-ink-line bg-ink-soft p-7"
              data-portfolio-card
              data-category={item.category}
              data-year={item.year}
              data-order={i}
              data-delay={(i % 3) * 90}
            >
              <div class="grid-bg absolute inset-0 opacity-30 transition-opacity duration-500 group-hover:opacity-50" />
              <div
                class={`absolute -right-10 -top-10 h-40 w-40 rounded-full blur-3xl transition-transform duration-500 group-hover:scale-125 ${ACCENTS[item.accent]} opacity-20`}
              />

              <div class="relative flex items-center justify-between">
                <span class="font-mono text-xs text-paper/40">{item.year}</span>
                <span class={`h-2 w-2 rounded-full ${ACCENTS[item.accent]}`} />
              </div>

              <div class="relative">
                {item.comingSoon && (
                  <span class="mb-4 inline-block rounded-full border border-ink-line px-3 py-1 font-mono text-[10px] uppercase tracking-[0.14em] text-paper/45">
                    Coming soon
                  </span>
                )}
                <h2 class="font-display text-2xl font-semibold tracking-tight text-paper">{item.title}</h2>
                <p class="mt-2 font-mono text-xs uppercase tracking-[0.1em] text-paper/40">{item.category}</p>
                <p class="mt-4 text-sm leading-relaxed text-paper/55">{item.summary}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden border-y border-ink-line bg-paper px-6 py-24 text-center text-ink lg:px-10">
    <h2 class="reveal mx-auto max-w-2xl font-display text-4xl font-semibold tracking-tight sm:text-5xl">
      Want to be the next case study?
    </h2>
    <a
      href="/contact"
      data-magnetic
      class="reveal mt-8 inline-flex items-center gap-3 rounded-sm bg-ink px-7 py-4 font-mono text-xs uppercase tracking-[0.14em] text-paper transition-transform"
      data-delay="80"
    >
      Start a Project
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 13 13 1M13 1H4M13 1v9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </section>
</Layout>
