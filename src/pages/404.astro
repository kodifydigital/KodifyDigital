---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Page Not Found" noindex>
  <section class="noise relative flex min-h-[80vh] items-center overflow-hidden px-6 pt-28 lg:px-10">
    <div class="grid-bg absolute inset-0 opacity-40 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_40%,black,transparent)]"></div>
    <div class="aurora-field" aria-hidden="true">
      <div class="aurora-blob aurora-blob-one"></div>
      <div class="aurora-blob aurora-blob-two"></div>
    </div>

    <div class="relative mx-auto max-w-2xl text-center">
      <p class="reveal font-mono text-sm text-signal">Error 404</p>
      <h1 class="reveal mt-4 font-display text-6xl font-semibold tracking-tight text-paper sm:text-7xl" data-delay="60">
        Lost signal.
      </h1>
      <p class="reveal mt-6 text-lg text-paper/60" data-delay="120">
        The page you're looking for doesn't exist, or moved somewhere new.
      </p>
      <a
        href="/"
        data-magnetic
        class="reveal mt-10 inline-flex items-center gap-3 rounded-sm bg-signal px-7 py-4 font-mono text-xs uppercase tracking-[0.14em] text-ink transition-transform"
        data-delay="180"
      >
        Back to Home
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1 13 13 1M13 1H4M13 1v9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
    </div>
  </section>
</Layout>
