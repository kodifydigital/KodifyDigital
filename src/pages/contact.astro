---
import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/vue/ContactForm.vue";
import { SITE } from "../data/site";
---

<Layout
  title="Contact"
  description="Get in touch with Kodify Digital — custom software and IT consultancy based in Kajang, Selangor, Malaysia."
>
  <section class="noise relative overflow-hidden px-6 pb-24 pt-40 lg:px-10">
    <div class="grid-bg absolute inset-0 opacity-40 [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,black,transparent)]"></div>
    <div class="aurora-field" aria-hidden="true">
      <div class="aurora-blob aurora-blob-one"></div>
      <div class="aurora-blob aurora-blob-two"></div>
    </div>

    <div class="relative mx-auto max-w-7xl">
      <p class="reveal font-mono text-xs uppercase tracking-[0.2em] text-signal">Contact</p>
      <h1 class="reveal mt-6 max-w-2xl font-display text-5xl font-semibold leading-[1.02] tracking-tight text-paper sm:text-6xl">
        Tell us what you're building.
      </h1>

      <div class="mt-16 grid gap-16 lg:grid-cols-[1fr_1.3fr]">
        <div class="reveal flex flex-col gap-10" data-delay="80">
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.14em] text-paper/45">Email</p>
            <a href={`mailto:${SITE.email}`} class="signal-underline mt-2 inline-block pb-1 text-lg text-paper">
              {SITE.email}
            </a>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.14em] text-paper/45">Phone</p>
            <a href={`tel:${SITE.phoneHref}`} class="signal-underline mt-2 inline-block pb-1 text-lg text-paper">
              {SITE.phone}
            </a>
          </div>
          <div>
            <p class="font-mono text-xs uppercase tracking-[0.14em] text-paper/45">Location</p>
            <p class="mt-2 text-lg text-paper/80">{SITE.address}</p>
          </div>
          <div class="mt-4 rounded-2xl border border-ink-line bg-ink-soft p-6">
            <p class="font-mono text-xs uppercase tracking-[0.14em] text-signal">Response time</p>
            <p class="mt-2 text-sm leading-relaxed text-paper/60">
              We reply to every inquiry within 1–2 business days with clear next steps.
            </p>
          </div>
        </div>

        <div class="reveal rounded-2xl border border-ink-line bg-ink-soft p-8 sm:p-10" data-delay="140">
          <ContactForm client:idle />
        </div>
      </div>
    </div>
  </section>
</Layout>
